+        SharedPreferences.Editor editor = activity.getSharedPreferences(DIAG_PREFS, Context.MODE_PRIVATE)
+                .edit().putString("latest", stamp + " — " + message);
+        if (failure) {
+            editor.putString("last_failure", stamp + " — " + message);
+            Log.w(TAG, message);
+        } else {
+            Log.i(TAG, message);
+        }
+        editor.apply();
+    }
+
+    /** Diagnóstico opcional: pressão longa em Pré-visualizar nas configurações. */
+    static void showDiagnostics(Activity activity) {
