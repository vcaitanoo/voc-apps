+        String state = prefs.getString("latest", "Ainda não houve pedidos no AOD.");
+        String failure = prefs.getString("last_failure", "Nenhuma falha registada.");
+        String report = "Tela Sempre Ativa — anúncios AOD\n" +
+                "Versão: " + BuildConfig.VERSION_NAME + " (" + BuildConfig.VERSION_CODE + ")\n" +
+                "Último estado: " + state + "\n" +
+                "Última falha: " + failure + "\n" +
+                "Intervalo pretendido: 5 minutos após anúncio apresentado.\n" +
+                "A exibição depende do consentimento e da disponibilidade do AdMob.";
+        new AlertDialog.Builder(activity)
+                .setTitle("Diagnóstico dos anúncios")
+                .setMessage(report)
+                .setPositiveButton("Fechar", null)
+                .setNeutralButton("Partilhar", (d, which) -> {
+                    Intent send = new Intent(Intent.ACTION_SEND);
+                    send.setType("text/plain");
+                    send.putExtra(Intent.EXTRA_TEXT, report);
+                    activity.startActivity(Intent.createChooser(send, "Partilhar diagnóstico"));
+                }).show();
