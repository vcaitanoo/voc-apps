+    /** The unbundled ML Kit model may still be downloading immediately after Play install. */
+    private void retryCutoutAfterModelDownload(String uriString, Exception error) {
+        if (!uriString.equals(prefs.getString(Prefs.PHOTO_URI, null))) return;
+        Log.w("TsaCutout", "Recorte aguardando modelo ML Kit", error);
+        if (pendingCutoutRetry != null) cutoutRetryHandler.removeCallbacks(pendingCutoutRetry);
+        final long[] delays = {8_000L, 20_000L, 45_000L};
+        if (cutoutFailureCount >= delays.length) {
+            Toast.makeText(this, "O modelo de recorte ainda não está disponível. Confira os Serviços Google Play e tente novamente mais tarde.", Toast.LENGTH_LONG).show();
+            return;
+        }
+        long delay = delays[cutoutFailureCount++];
+        if (cutoutFailureCount == 1)
+            Toast.makeText(this, "A preparar o recorte. O modelo será tentado novamente automaticamente.", Toast.LENGTH_LONG).show();
+        pendingCutoutRetry = () -> {
+            pendingCutoutRetry = null;
+            if (isFinishing() || isDestroyed()) return;
+            if (uriString.equals(prefs.getString(Prefs.PHOTO_URI, null)))
+                updateCutout(Uri.parse(uriString), uriString);
+        };
+        cutoutRetryHandler.postDelayed(pendingCutoutRetry, delay);
+    }
