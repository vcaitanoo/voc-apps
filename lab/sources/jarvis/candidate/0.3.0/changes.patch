+package pt.vcaitano.jarvis.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class WakeWordDetectorTest {
+    @Test
+    fun `accepts expected Portuguese STT variants`() {
+        listOf("Jarvis", "Járvis", "Javis", "Járves", "Jarves", "Jervis").forEach {
+            assertTrue("should accept $it", WakeWordDetector.contains(it))
+        }
+    }
+
+    @Test
+    fun `returns the original command boundary`() {
+        val phrase = "Ei, Járves, que horas são?"
+        val match = WakeWordDetector.find(phrase)
+        assertNotNull(match)
+        assertEquals("que horas são?", phrase.substring(match!!.endExclusive).trim(' ', ','))
+    }
+
+    @Test
+    fun `does not wake for unrelated ambient words`() {
+        listOf("avis", "chaves", "jardins", "serviço", "já vi isso").forEach {
+            assertFalse("should reject $it", WakeWordDetector.contains(it))
+        }
+    }
+}
