--- a/app/src/main/java/pt/vcaitano/jarvis/voice/SpeechCoordinator.kt	1970-01-01 09:00:00.000000000 +0900
+++ b/app/src/main/java/pt/vcaitano/jarvis/voice/SpeechCoordinator.kt	2026-09-03 10:38:04.102967045 +0900
@@ -0,0 +1,31 @@
+package pt.vcaitano.jarvis.voice
+
+/** Coordena microfone e fala dentro do processo. Uma fala nova interrompe a
+ * anterior e pausa o reconhecimento para que o Jarvis não transcreva a si mesmo. */
+object SpeechCoordinator {
+    private data class Owner(val id: String, val stop: () -> Unit)
+    private val lock = Any()
+    private var current: Owner? = null
+
+    fun claim(id: String, stopPrevious: () -> Unit) {
+        val previous = synchronized(lock) {
+            val old = current?.takeIf { it.id != id }
+            current = Owner(id, stopPrevious)
+            old
+        }
+        previous?.stop?.invoke()
+    }
+
+    fun release(id: String) {
+        synchronized(lock) {
+            if (current?.id == id) current = null
+        }
+    }
+
+    fun isOwner(id: String): Boolean = synchronized(lock) { current?.id == id }
+
+    fun isOwnedByOther(vararg allowedIds: String): Boolean = synchronized(lock) {
+        val owner = current?.id ?: return@synchronized false
+        owner !in allowedIds
+    }
+}
