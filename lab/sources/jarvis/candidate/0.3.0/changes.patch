diff -ruN '--exclude=*.png' a/app/src/main/java/pt/vcaitano/jarvis/voice/WakeWordDetector.kt b/app/src/main/java/pt/vcaitano/jarvis/voice/WakeWordDetector.kt
--- a/app/src/main/java/pt/vcaitano/jarvis/voice/WakeWordDetector.kt	1970-01-01 09:00:00.000000000 +0900
+++ b/app/src/main/java/pt/vcaitano/jarvis/voice/WakeWordDetector.kt	2026-09-03 05:26:43.663469413 +0900
@@ -0,0 +1,64 @@
+package pt.vcaitano.jarvis.voice
+
+import java.text.Normalizer
+import java.util.Locale
+
+/** Detector isolado do reconhecimento de comando. Tolera as pequenas
+ * substituições/omissões que o STT em português costuma produzir em “Jarvis”. */
+object WakeWordDetector {
+    data class Match(val start: Int, val endExclusive: Int, val confidence: Float)
+
+    private const val CANONICAL = "jarvis"
+    private val word = Regex("[\\p{L}\\p{M}]+")
+
+    fun find(text: String): Match? {
+        return word.findAll(text).mapNotNull { candidate ->
+            val normalized = normalize(candidate.value)
+            val distance = when {
+                normalized.length !in 5..7 -> Int.MAX_VALUE
+                !normalized.startsWith('j') -> Int.MAX_VALUE
+                else -> levenshtein(normalized, CANONICAL, maxDistance = 1)
+            }
+            if (distance <= 1) {
+                Match(
+                    start = candidate.range.first,
+                    endExclusive = candidate.range.last + 1,
+                    confidence = if (distance == 0) 1f else 0.86f
+                )
+            } else null
+        }.firstOrNull()
+    }
+
+    fun contains(text: String): Boolean = find(text) != null
+
+    internal fun normalize(value: String): String {
+        val decomposed = Normalizer.normalize(value, Normalizer.Form.NFD)
+        return decomposed
+            .replace(Regex("\\p{M}+"), "")
+            .lowercase(Locale.ROOT)
+            .filter(Char::isLetter)
+    }
+
+    /** Retorna cedo quando já é impossível ficar dentro do limite. */
+    private fun levenshtein(left: String, right: String, maxDistance: Int): Int {
+        if (kotlin.math.abs(left.length - right.length) > maxDistance) return maxDistance + 1
+        var previous = IntArray(right.length + 1) { it }
+        for (i in left.indices) {
+            val current = IntArray(right.length + 1)
+            current[0] = i + 1
+            var rowMinimum = current[0]
+            for (j in right.indices) {
+                val substitution = previous[j] + if (left[i] == right[j]) 0 else 1
+                current[j + 1] = minOf(
+                    current[j] + 1,
+                    previous[j + 1] + 1,
+                    substitution
+                )
+                rowMinimum = minOf(rowMinimum, current[j + 1])
+            }
+            if (rowMinimum > maxDistance) return maxDistance + 1
+            previous = current
+        }
+        return previous[right.length]
+    }
+}
