+package pt.vcaitano.jarvis.settings
+
+import android.content.Context
+
+/** Centraliza preferências do agente para que Activity, serviços e receivers
+ * observem exatamente os mesmos valores, inclusive após o processo morrer. */
+class JarvisSettings(context: Context) {
+    private val preferences = context.applicationContext.getSharedPreferences(
+        PREFERENCES,
+        Context.MODE_PRIVATE
+    )
+
+    var readResponses: Boolean
+        get() = preferences.getBoolean(KEY_READ_RESPONSES, true)
+        set(value) = preferences.edit().putBoolean(KEY_READ_RESPONSES, value).apply()
+
+    var wakeWordEnabled: Boolean
+        get() = preferences.getBoolean(KEY_WAKE_WORD, true)
+        set(value) = preferences.edit().putBoolean(KEY_WAKE_WORD, value).apply()
+
+    var personalMemoryEnabled: Boolean
+        get() = preferences.getBoolean(KEY_PERSONAL_MEMORY, true)
+        set(value) = preferences.edit().putBoolean(KEY_PERSONAL_MEMORY, value).apply()
+
+    var spokenRemindersEnabled: Boolean
+        get() = preferences.getBoolean(KEY_SPOKEN_REMINDERS, true)
+        set(value) = preferences.edit().putBoolean(KEY_SPOKEN_REMINDERS, value).apply()
+
+    var proactivityEnabled: Boolean
+        get() = preferences.getBoolean(KEY_PROACTIVITY, true)
+        set(value) = preferences.edit().putBoolean(KEY_PROACTIVITY, value).apply()
+
+    companion object {
+        private const val PREFERENCES = "jarvis_agent_settings"
+        private const val KEY_READ_RESPONSES = "read_responses"
+        private const val KEY_WAKE_WORD = "wake_word_enabled"
+        private const val KEY_PERSONAL_MEMORY = "personal_memory_enabled"
+        private const val KEY_SPOKEN_REMINDERS = "spoken_reminders_enabled"
+        private const val KEY_PROACTIVITY = "proactivity_enabled"
+    }
+}
