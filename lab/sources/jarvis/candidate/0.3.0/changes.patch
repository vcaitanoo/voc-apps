+package pt.vcaitano.jarvis.agent.routine
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import pt.vcaitano.jarvis.agent.model.RecurrenceKind
+import java.time.DayOfWeek
+import java.time.LocalDate
+
+class RoutineParserTest {
+    @Test
+    fun `parses weekly Saturday routine`() {
+        val parsed = RoutineParser.parse("Todo sábado tenho que buscar X")!!
+        assertEquals(RecurrenceKind.WEEKLY, parsed.kind)
+        assertEquals(setOf(DayOfWeek.SATURDAY), parsed.weekdays)
+    }
+
+    @Test
+    fun `parses routine every two weeks without fixed phrase logic`() {
+        val reference = LocalDate.of(2026, 9, 3)
+        val parsed = RoutineParser.parse("A cada duas semanas faço a revisão", reference)!!
+        assertEquals(RecurrenceKind.EVERY_N_WEEKS, parsed.kind)
+        assertEquals(2, parsed.interval)
+        assertEquals(setOf(reference.dayOfWeek), parsed.weekdays)
+    }
+
+    @Test
+    fun `parses monthly routine and optional time`() {
+        val parsed = RoutineParser.parse("Todo dia 5 às 11:30 faço o pedido")!!
+        assertEquals(RecurrenceKind.MONTHLY, parsed.kind)
+        assertEquals(5, parsed.dayOfMonth)
+        assertEquals(11, parsed.hour)
+        assertEquals(30, parsed.minute)
+        assertTrue(parsed.weekdays.isEmpty())
+    }
+}
